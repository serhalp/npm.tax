{
  "name": "npm.tax",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "build:analyze": "rm -rf .sonda/ && SONDA=true vite build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "pnpm run typecheck && pnpm run format:check && pnpm run lint && pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "node --test",
    "test:unit:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**'",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.34",
    "@vercel/og": "^0.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semver": "^7.8.5",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@e18e/eslint-plugin": "^0.8.0",
    "@netlify/vite-plugin-tanstack-start": "^1.3.17",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^6.0.5",
    "knip": "^6.31.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.76.0",
    "sonda": "^0.14.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=26.0.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
